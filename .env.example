# Public API base URL for the companion Express backend
NEXT_PUBLIC_API_URL=http://localhost:5000

# Supabase project URL and public/anon key (browser-visible; never put a service-role key here)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side JWT signing secret used by frontend auth helpers; generate a strong unique secret
JWT_SECRET=

# Required if the support AI endpoint is enabled
OPENAI_API_KEY=

# Required for production rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: daily support-AI request budget (defaults to 500 in the route)
SUPPORT_AI_DAILY_LIMIT=500
